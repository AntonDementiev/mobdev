    "permission.settingsAlert.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS doesn't show the permission request again after it was denied. Open Settings and allow access to contacts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После отказа iOS не показывает системный запрос повторно. Откройте Настройки и разрешите доступ к контактам."
          }
        }
      }
    },
